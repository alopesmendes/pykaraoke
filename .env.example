# Copy this file to .env and fill in real values. .env is gitignored and
# .claude/settings.json denies Claude from ever reading it.
#
# Generate a real secret key:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# DEBUG is set per settings module (dev.py on, prod.py off), not from this file.

# Comma-separated. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins with scheme, needed behind a proxy such as Render. Omit locally.
# CSRF_TRUSTED_ORIGINS=https://pykaraoke-dev.onrender.com

# Serves /api/schema/ and /api/docs/. Dev defaults to on, prod to off. Leave commented
# out: an empty value reads as False and would switch the dev docs off.
# ENABLE_API_DOCS=True

# Omit for the SQLite fallback (zero setup). Set once docker-compose.yml is up:
#   DATABASE_URL=postgres://pykaraoke:pykaraoke@localhost:5432/pykaraoke
DATABASE_URL=

# Omit for the console backend (emails print to the terminal). Set once mailpit
# is running via docker-compose:
#   EMAIL_URL=smtp://localhost:1025
EMAIL_URL=
